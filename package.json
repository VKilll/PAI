{
  "name": "pa-atelier",
  "version": "1.0.0",
  "description": "PA Atelier — Influencer Management App",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "db:init": "cd server && node database/init.js",
    "db:seed": "cd server && node database/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
